# Αντίγραψε αυτό το αρχείο σε ".env" και συμπλήρωσε τις τιμές.

# API key από το HeroSMS (προφίλ -> API)
HERO_API_KEY=

# Bot token από το @BotFather
TELEGRAM_BOT_TOKEN=
# Βρίσκεται με: python herosms_notifier.py --chat-id
TELEGRAM_CHAT_ID=

# Τι παρακολουθούμε: υπηρεσία:χώρα[:ώρες_ενοικίασης], χωρισμένα με κόμμα.
# Χωρίς ώρες = κανονική ενεργοποίηση (20 λεπτά). Με ώρες = ενοικίαση (24, 72, 168=7 ημέρες, 336, 720...).
# Κωδικοί υπηρεσιών: https://hero-sms.com/stubs/handler_api.php?action=getServicesList
# ID χωρών:          https://hero-sms.com/stubs/handler_api.php?action=getCountries
# Παράδειγμα: ot:129:168 = Any other, Ελλάδα, ενοικίαση 7 ημερών
WATCH=ot:129:168

# Αγορά από το Telegram (μόνο για ενοικιάσεις):
# Μέγιστος αριθμός ανά αγορά (κενό = χωρίς όριο, πάντα μέχρι όσο φτάνει το υπόλοιπο)
MAX_BUY=
# Πόσα λεπτά περιμένει για κουμπιά μετά από ειδοποίηση ή πάτημα
BUY_WINDOW_MINUTES=10
